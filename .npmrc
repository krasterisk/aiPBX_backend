# onnxruntime-node postinstall downloads optional CUDA EP binaries from NuGet/Azure CDN.
# Silero VAD (@ricky0123/vad-node) only needs the CPU binaries already bundled in the npm package.
# Without skip, Docker/CI builds fail with ETIMEDOUT to Microsoft CDN (e.g. 150.171.109.51:443).
onnxruntime-node-install=skip
